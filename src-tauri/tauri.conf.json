{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Next-Gen Yaskawa Motoman Ladder IDE",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.antigravity.yaskawa-ladder-ide",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "permissions": [
    "core:default",
    "core:path:default",
    "core:file:default",
    "core:network:default",
    {
      "identifier": "allow-fs-access",
      "description": "Разрешить чтение и запись файлов проектов и листингов .LST",
      "allow": [
        { "path": "$HOME/.antigravity-ladder/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "allow-network-access",
      "description": "Разрешить сетевое взаимодействие с контроллерами роботов Motoman (FTP, HSE)",
      "allow": [
        { "host": "*", "ports": [21, 8040] }
      ]
    }
  ]
}
