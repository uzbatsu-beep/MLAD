{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "MLAD Bench",
  "version": "0.5.0",
  "identifier": "com.antigravity.yaskawa-ladder-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MLAD Bench | OEM 5-Opcode Reference rc.9 · OFFLINE",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "base-uri": "'none'",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
